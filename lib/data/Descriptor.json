{
	"openapi": "3.0.2",
	"info": {
		"title": "mia",
		"version": "2.0.3",
		"description": "MIA - easy IOT.",
		"contact": {
			"name": "Sébastien VIDAL",
			"url": "https://github.com/Psychopoulet/mia/issues"
		},
		"license": {
			"name": "ISC",
			"url": "https://en.wikipedia.org/wiki/ISC_license"
		}
	},
	"paths": {

		"/api/descriptor": {
			"get": {
				"description": "",
				"summary": "API Swagger",
				"operationId": "getDescriptor",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/": {
			"get": {
				"description": "",
				"summary": "Front page",
				"responses": {
					"302": {
						"description": "Redirection to /public/index.html"
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/index.html": {
			"get": {
				"description": "",
				"summary": "Front page",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/menu.min.js": {
			"get": {
				"description": "",
				"summary": "Global app menu",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/menu.min.js.map": {
			"get": {
				"description": "",
				"summary": "Global app menu map",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Front app",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Front app map",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/api/auth": {
			"put": {
				"description": "",
				"summary": "Login",
				"operationId": "login",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/User"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Authorization token",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Token"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"delete": {
				"description": "",
				"summary": "Logout",
				"operationId": "logout",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"204": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/api/plugins": {
			"get": {
				"description": "",
				"summary": "Get all plugins",
				"operationId": "getPlugins",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Plugins list",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"uniqueItems": true,
									"items": {
										"$ref": "#/components/schemas/Plugin"
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"put": {
				"description": "",
				"summary": "Add a plugin from a GitHub repository",
				"operationId": "installPluginFromGithub",
				"security": [
					{ "bearerAuth": [] }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"path": {
										"type": "string",
										"description": "GitHub repository path (owner/repo)",
										"minLength": 8
									}
								},
								"required": [ "path" ]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/api/plugins/{name}": {
			"post": {
				"description": "",
				"summary": "Update a plugin from its GitHub repository",
				"operationId": "updatePluginFromGithub",
				"security": [
					{ "bearerAuth": [] }
				],
				"parameters": [
					{
						"name": "name",
						"in": "path",
						"required": true,
						"schema": {
							"$ref": "#/components/schemas/PluginName"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"delete": {
				"description": "",
				"summary": "Delete a plugin",
				"operationId": "deletePlugin",
				"security": [
					{ "bearerAuth": [] }
				],
				"parameters": [
					{
						"name": "name",
						"in": "path",
						"required": true,
						"schema": {
							"$ref": "#/components/schemas/PluginName"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/api/plugins/{name}/latest-tag": {
			"get": {
				"description": "",
				"summary": "Get the latest tag of a plugin",
				"operationId": "getPluginLatestTag",
				"security": [
					{ "bearerAuth": [] }
				],
				"parameters": [
					{
						"name": "name",
						"in": "path",
						"required": true,
						"schema": {
							"$ref": "#/components/schemas/PluginName"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"Error": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"PluginName": {
				"type": "string",
				"minLength": 5,
				"pattern": "^mia-[a-zA-Z0-9_-]+$"
			},
			"Version": {
				"type": "string",
				"minLength": 5,
				"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
			},
			"User": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"password": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [ "name", "password" ]
			},
			"Token": {
				"type": "string",
				"minLength": 1
			},
			"Plugin": {
				"type": "object",
				"properties": {
					"name": {
						"$ref": "#/components/schemas/PluginName"
					},
					"version": {
						"$ref": "#/components/schemas/Version"
					},
					"description": {
						"type": "string",
						"minLength": 1
					},
					"enabled": {
						"type": "boolean"
					},
					"dependencies": {
						"type": "object",
						"additionalProperties": true
					},
					"engines": {
						"type": "object",
						"properties": {
							"node": {
								"$ref": "#/components/schemas/Version"
							}
						}
					},
					"authors": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "string"
						}
					},
					"license": {
						"type": "string"
					},
					"repository": {
						"type": "string",
						"format": "uri"
					}
				},
				"required": [ "name", "version", "description", "enabled", "dependencies", "engines", "authors", "license" ]
			},
			"PushEventPluginInstallRunning": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInstallRunning"
			},
			"PushEventPluginInstallStep": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInstallStep"
			},
			"PushEventPluginInstallSuccess": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInstallSuccess"
			},
			"PushEventPluginInstallFail": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInstallFail"
			},
			"PushEventPluginUpdateRunning": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUpdateRunning"
			},
			"PushEventPluginUpdateStep": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUpdateStep"
			},
			"PushEventPluginUpdateSuccess": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUpdateSuccess"
			},
			"PushEventPluginUpdateFail": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUpdateFail"
			},
			"PushEventPluginUninstallRunning": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUninstallRunning"
			},
			"PushEventPluginUninstallSuccess": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUninstallSuccess"
			},
			"PushEventPluginUninstallFail": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginUninstallFail"
			}
		}
	},
	"externalDocs": {
		"description": "Find out more about this API",
		"url": "https://github.com/Psychopoulet/mia#readme"
	},
	"servers": [
		{
			"description": "Local testing server",
			"url": "http://localhost:8000"
		}
	]
}