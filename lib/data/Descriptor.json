{
	"openapi": "3.0.2",
	"info": {
		"title": "mia",
		"version": "1.4.0",
		"description": "MIA - easy IOT.",
		"contact": {
			"name": "Sébastien VIDAL",
			"url": "https://github.com/Psychopoulet/mia/issues"
		},
		"license": {
			"name": "ISC",
			"url": "https://en.wikipedia.org/wiki/ISC_license"
		}
	},
	"paths": {

		"/api/descriptor": {
			"get": {
				"description": "",
				"summary": "API Swagger",
				"operationId": "getDescriptor",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/": {
			"get": {
				"description": "",
				"summary": "Front page",
				"responses": {
					"301": {
						"description": "Redirection to /public/index.html"
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/index.html": {
			"get": {
				"description": "",
				"summary": "Front page",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/menu.min.js": {
			"get": {
				"description": "",
				"summary": "Global app menu",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/menu.min.js.map": {
			"get": {
				"description": "",
				"summary": "Global app menu map",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Front app",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"text/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Front app map",
				"responses": {
					"200": {
						"description": "Everything is fine",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/api/plugins": {
			"get": {
				"description": "",
				"summary": "Get all plugins",
				"operationId": "getPlugins",
				"responses": {
					"200": {
						"description": "Plugins list",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"uniqueItems": true,
									"items": {
										"$ref": "#/components/schemas/Plugin"
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"put": {
				"description": "",
				"summary": "Add a plugin from a GitHub repository",
				"operationId": "installPluginFromGithub",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"path": {
										"type": "string",
										"description": "GitHub repository path (owner/repo)"
									}
								},
								"required": [ "path" ]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occured",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}

	},
	"components": {
		"schemas": {
			"Error": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"Plugin": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"version": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"enabled": {
						"type": "boolean"
					},
					"dependencies": {
						"type": "object",
						"additionalProperties": true
					},
					"engines": {
						"type": "object",
						"properties": {
							"node": {
								"type": "string"
							}
						}
					},
					"authors": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "string"
						}
					},
					"license": {
						"type": "string"
					}
				},
				"required": [ "name", "version", "description", "enabled", "dependencies", "engines", "authors", "license" ]
			},
			"PushEventPluginInstallRunning": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"type": "string",
						"enum": [ "core" ]
					},
					"command": {
						"type": "string",
						"enum": [ "plugin-install-running" ]
					},
					"data": {
						"type": "string"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventPluginInstallSuccess": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"type": "string",
						"enum": [ "core" ]
					},
					"command": {
						"type": "string",
						"enum": [ "plugin-install-success" ]
					},
					"data": {
						"type": "string"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventPluginInstallFail": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"type": "string",
						"enum": [ "core" ]
					},
					"command": {
						"type": "string",
						"enum": [ "plugin-install-fail" ]
					},
					"data": {
						"type": "string"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			}
		}
	},
	"externalDocs": {
		"description": "Find out more about this API",
		"url": "https://github.com/Psychopoulet/mia#readme"
	}
}