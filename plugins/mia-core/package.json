{

  "name": "mia-core",
  "version": "2.3.0",
  "description": "MIA - easy IOT.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "install-prod": "bun install --production",
    "install-dev": "bun install",

    "transpile-openapi-back": "bunx openapi-typescript ./lib/data/Descriptor.json -o ./lib/src/Descriptor.ts",
    "transpile-openapi-front": "bunx openapi-typescript ./lib/data/Descriptor.json -o ./public/src/Descriptor.ts",
    "transpile-openapi": "bun run transpile-openapi-back && bun run transpile-openapi-front",

    "lint-back": "bun run transpile-openapi-back && bunx eslint --config .eslintrc-back.js --ext .ts,.cts,.mts \"./lib/src/**/*\"",
    "lint-front": "bun run transpile-openapi-front && bunx eslint --config .eslintrc-front.js --ext .tsx,.ts \"./public/src/**/*\"",
    "lint-tests": "bunx eslint --config .eslintrc-tests.js --ext .js \"./test/**/*\"",
    "lint": "bun run lint-back && bun run lint-front && bun run lint-tests",

    "clean-back": "bunx rimraf ./lib/cjs",
    "clean-front": "bunx rimraf ./public/dist",
    "clean": "bun run clean-back && bun run clean-front",

    "import-types": "node ./build/importTypes.js",
    "build-back": "bun run clean-back && bun run import-types && bun run transpile-openapi-back && bunx tsc --project ./tsconfig.json",
    "build-front": "bun run clean-front && bun run transpile-openapi-front && bunx webpack --config ./webpack.config.js && bunx webpack --config ./webpack.config-menu.js",
    "build": "bun run build-back && bun run build-front",

    "check-node-engine": "bunx check-node-engine",
    "check-requires": "bunx used-deps-analyzer ./package.json ./lib/src --no-dev  --misscalled \"{ \\\"module\\\": \\\"@types/express\\\", \\\"call\\\": \\\"express\\\" }\"",
    "check-updates": "bunx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "bunx c8 --reporter=text-summary --all --include \"lib/src/**/*.ts\" --include \"lib/src/**/*.cts\" --exclude \"lib/src/Descriptor.ts\" --exclude \"lib/src/**/*.d.ts\" --extension .ts --extension .cts --check-coverage --statements 95 --branches 95 --functions 95 --lines 95 mocha --require ./test/register.js",
    "unit-tests-local": "bunx c8 --reporter=html --reporter=text --all --include \"lib/src/**/*.ts\" --include \"lib/src/**/*.cts\" --exclude \"lib/src/Descriptor.ts\" --extension .ts --extension .cts mocha --require ./test/register.js",

    "tests": "bun run lint && bun run check-node-engine && bun run check-requires && bun run check-updates && bun run build && bun run unit-tests"

  },
  "files": [
    "lib/cjs",
    "lib/data",
    "public/dist",
    "public/index.html"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.22.2",
    "bun": ">=1.4.5"
  },

  "dependencies": {
    "node-pluginsmanager-plugin": "7.4.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/socket.io": "3.0.2",
    "@types/ws": "8.18.2",
    "c8": "12.0.0",
    "check-node-engine": "1.2.1",
    "check-version-modules": "2.5.2",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "husky": "9.1.7",
    "mocha": "12.0.3",
    "node-confmanager": "1.15.1",
    "node-containerpattern": "1.12.1",
    "node-pluginsmanager": "3.8.3",
    "openapi-typescript": "7.13.0",
    "react": "19.3.1",
    "react-bootstrap-fontawesome": "git+ssh://git@github.com/Psychopoulet/react-bootstrap-fontawesome",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sequelize": "6.37.8",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "used-deps-analyzer": "0.4.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.1",
    "uuid": "11.1.1"
  },

  "author": "Sébastien VIDAL",
  "contributors": [],
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/mia#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/mia.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/mia/issues"
  }

}
