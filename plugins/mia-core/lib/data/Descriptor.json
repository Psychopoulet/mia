						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"path": {
										"type": "string",
										"description": "GitHub repository path (owner/repo)",
										"minLength": 8
									}
								},
								"required": [
									"path"
								]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Add a plugin from a GitHub repository",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
