		"/mia-core/api/logs": {
			"get": {
				"description": "",
				"summary": "Read logs in a date range",
				"operationId": "getLogs",
				"security": [
					{ "bearerAuth": [] }
				],
				"parameters": [
					{
						"name": "from",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					},
					{
						"name": "to",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					},
					{
						"name": "level",
						"in": "query",
						"required": false,
						"schema": {
							"$ref": "#/components/schemas/LogLevel"
						}
					}
				],
				"responses": {
					"200": {
						"description": "One formatted log line per record",
						"content": {
							"text/plain": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"delete": {
				"description": "",
				"summary": "Purge logs in a date range",
				"operationId": "deleteLogs",
				"security": [
					{ "bearerAuth": [] }
				],
				"parameters": [
					{
						"name": "from",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					},
					{
						"name": "to",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Logs purged"
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [
					"mia-core"
				]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [
					"code",
					"message"
				]
			},
			"Version": {
				"type": "string",
				"minLength": 5,
				"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
			},
			"User": {
				"type": "object",
				"description": "Public user representation (no password)",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"description": "Immutable username"
					},
					"isAdmin": {
