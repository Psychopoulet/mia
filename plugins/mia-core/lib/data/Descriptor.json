		"/mia-core/api/users/{name}/tokens": {
			"parameters": [
				{
					"name": "name",
					"in": "path",
					"required": true,
					"schema": {
						"type": "string",
						"minLength": 1
					}
				}
			],
			"get": {
				"description": "",
				"summary": "List user tokens",
				"operationId": "getUserTokens",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Tokens list",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"token": {
												"type": "string",
												"minLength": 1
											},
											"fingerprint": {
												"type": "string"
											},
											"createdAt": {
												"type": "string",
												"format": "date-time"
											}
										},
										"required": [
											"token",
											"fingerprint",
											"createdAt"
										]
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
