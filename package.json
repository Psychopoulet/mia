{

  "name": "mia",
  "version": "1.5.0",
  "description": "MIA - easy IOT.",

  "type": "commonjs",
  "typings": "./lib/cjs/main.d.cts",
  "main": "./lib/cjs/main.cjs",

  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/main.d.cts",
        "default": "./lib/cjs/main.cjs"
      }
    }
  },

  "scripts": {

    "transpile-openapi-back": "npx openapi-typescript ./lib/data/Descriptor.json -o ./lib/src/api/Descriptor.ts",
    "transpile-openapi-front": "npx openapi-typescript ./lib/data/Descriptor.json -o ./public/src/Descriptor.ts",
    "transpile-openapi": "npm run transpile-openapi-back && npm run transpile-openapi-front",

    "lint-back": "npx eslint --config .eslintrc-back.js --ext .ts,.cts,.mts ./lib/src/**/*",
    "lint-front": "echo 'Frontend lint not implemented yet.'",
    "lint-tests": "echo 'Tests not implemented yet.'",
    "lint": "npm run lint-back && npm run lint-front && npm run lint-tests",

    "clean-back": "npx rimraf ./lib/cjs && npx rimraf ./lib/src/api/Descriptor.ts",
    "clean-front": "npx rimraf ./public/cjs && npx rimraf ./public/src/Descriptor.ts",
    "clean": "npm run clean-back && npm run clean-front",

    "build-back": "npm run clean-back && npm run transpile-openapi-back && npx tsc --project ./tsconfig.json",
    "build-front": "npm run clean-front && npm run transpile-openapi-front && npx webpack --config ./webpack.config.js && npx webpack --config ./webpack.menu.config.js",
    "build": "npm run build-back && npm run build-front",

    "check-node-engine": "npx check-node-engine",
    "check-requires": "npx used-deps-analyzer \"./package.json\" \"./lib/src\" --no-dev --shadows @fortawesome/fontawesome-free --misscalled \"{ \\\"module\\\": \\\"@fortawesome/fontawesome-free\\\", \\\"call\\\": \\\"@fortawesome\\\" }\"",
    "check-updates": "npx check-version-modules --no-fail-at-major --fail-at-minor --fail-at-patch",
    "unit-tests": "npx mocha",
    "unit-tests-local": "npx nyc --reporter=html --reporter=text mocha",

    "tests": "npm run lint && npm run check-node-engine && npm run check-requires && npm run check-updates && npm run build && npm run unit-tests-local",

    "start": "node lib/cjs/main.cjs",

    "daemon-start": "npx pm2 start pm2.json",
    "daemon-stop": "npx pm2 stop pm2.json && npx pm2 delete pm2.json",

    "docker-start": "docker image build --rm -t image-mia . && docker container run -dti -p 8000:8000 --name container-mia image-mia",
    "docker-stop": "docker container stop container-mia && docker container remove -f container-mia && docker image remove -f image-mia"

  },

  "files": [
    "lib/cjs",
    "public/dist",
    "public/pictures",
    "public/index.html",
    "pm2.json"
  ],
  "engines": {
    "node": ">=22.23.1"
  },

  "dependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "bootstrap": "5.3.8",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "node-confmanager": "1.15.0",
    "node-containerpattern": "1.12.0",
    "node-pluginsmanager": "3.7.1",
    "node-pluginsmanager-plugin": "7.4.3",
    "uniqid": "5.4.0",
    "winston": "3.19.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/socket.io": "3.0.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/uniqid": "5.3.4",
    "@types/ws": "8.18.1",
    "check-node-engine": "1.1.0",
    "check-version-modules": "2.5.0",
    "eslint-plugin-personnallinter": "git+ssh://git@github.com/Psychopoulet/eslint-plugin-personnallinter",
    "husky": "9.1.7",
    "mocha": "11.7.6",
    "openapi-typescript": "7.13.0",
    "react": "19.2.8",
    "react-bootstrap-fontawesome": "git+ssh://git@github.com/Psychopoulet/react-bootstrap-fontawesome",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "terser-webpack-plugin": "5.6.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "used-deps-analyzer": "0.4.0",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1"
  },
  "optionalDependencies": {
    "pm2": "7.0.3"
  },

  "author": "Sébastien VIDAL",
  "contributors": [],
  "license": "ISC",

  "homepage": "https://github.com/Psychopoulet/mia#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/Psychopoulet/mia.git"
  },
  "bugs": {
    "url": "https://github.com/Psychopoulet/mia/issues"
  }

}
